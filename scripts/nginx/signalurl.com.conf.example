# /etc/nginx/sites-available/signalurl.com
# upstream signalurl_app → 127.0.0.1:3000

server {
    listen 80;
    listen [::]:80;
    server_name signalurl.com www.signalurl.com;

    client_max_body_size 4m;

    location = /_next/image {
        return 404;
    }

    location / {
        limit_req zone=signalurl_site burst=40 nodelay;
        limit_conn signalurl_conn 30;

        proxy_pass http://signalurl_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
